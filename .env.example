# Copia este archivo a ".env" y ajusta los valores. NUNCA subas ".env" a GitHub.
PORT=3000
# Local: mongodb://127.0.0.1:27017/reto  |  Nube: cadena de MongoDB Atlas
MONGO_URI=mongodb://127.0.0.1:27017/reto
# Cadena larga y aleatoria. Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=2h
